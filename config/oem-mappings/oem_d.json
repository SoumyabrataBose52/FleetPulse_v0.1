    "speed_kmh": {
      "source": "5",
      "transform": "scale",
      "factor": 0.1
    },
    "odo_km": {
      "source": "6",
      "transform": "scale",
      "factor": 0.1
    },
    "ignition": {
      "source": "7",
      "transform": "enum_map",
      "mapping": {
        "1": true,
        "0": false
      }
    },
    "fuel_pct": {
      "source": "8",
      "transform": "scale",
      "factor": 0.1
