# FleetPulse — Environment Variables Example
# Copy this file to .env and fill in real values
# DO NOT commit .env to git

# --- PostgreSQL ---
POSTGRES_USER=fleetpulse
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=fleetpulse

# --- ClickHouse ---
CLICKHOUSE_USER=fleetpulse
CLICKHOUSE_PASSWORD=CHANGE_ME

# --- Redis ---
REDIS_PASSWORD=CHANGE_ME

# --- MongoDB ---
MONGO_ROOT_USERNAME=fleetpulse
MONGO_ROOT_PASSWORD=CHANGE_ME

# --- MinIO ---
MINIO_ROOT_USER=fleetpulse
MINIO_ROOT_PASSWORD=CHANGE_ME

# --- API ---
SECRET_KEY=CHANGE_ME_TO_RANDOM_32_CHAR_STRING
JWT_ALGORITHM=RS256
JWKS_URL=http://keycloak:8080/realms/fleetpulse/protocol/openid-connect/certs

# --- Simulator ---
SIMULATOR_SEED=42
SIMULATOR_PRESET=dev
GATEWAY_URL=http://gateway:8080

# --- Feature flags ---
ENABLE_SHARING_API=true
ENABLE_ERASURE=true
