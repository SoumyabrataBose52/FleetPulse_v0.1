# FleetPulse — Default Environment Variables
# Ready-to-run defaults for local development & evaluation

# --- PostgreSQL ---
POSTGRES_USER=fleetpulse
POSTGRES_PASSWORD=fleetpulse_dev
POSTGRES_DB=fleetpulse

# --- ClickHouse ---
CLICKHOUSE_USER=fleetpulse
CLICKHOUSE_PASSWORD=fleetpulse_dev

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379

# --- MongoDB ---
MONGO_ROOT_USERNAME=fleetpulse
MONGO_ROOT_PASSWORD=fleetpulse_dev

# --- MinIO ---
MINIO_ROOT_USER=fleetpulse
MINIO_ROOT_PASSWORD=fleetpulse_dev

# --- API ---
SECRET_KEY=fleetpulse_development_secret_key_32chars!
JWT_ALGORITHM=RS256

# --- Simulator ---
SIMULATOR_SEED=42
SIMULATOR_PRESET=dev
GATEWAY_URL=http://gateway:8080

# --- Feature Flags ---
ENABLE_SHARING_API=true
